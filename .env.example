# Demo mode (default). The app runs entirely in the browser with mock data.
VITE_USE_MOCKS=true

# When the real Spring Boot backend exists:
#   VITE_USE_MOCKS=false
#   VITE_API_BASE_URL=https://api.example.org/api/v1
# Only public values belong here. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=
